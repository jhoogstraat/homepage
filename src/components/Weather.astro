---
import { messages, type Locale } from "@/src/lib/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = messages[locale].weather;
---
<section id="weather" class="border rounded-lg p-3" data-copy={JSON.stringify(copy)}>
  <div class="flex items-center gap-3">
    <span data-icon class="text-2xl" aria-hidden="true">🌡️</span>
    <div class="min-w-0 flex-1">
      <h2 class="text-xs text-muted-foreground">{copy.title} · Berlin</h2>
      <p data-condition class="text-sm">{copy.unavailable}</p>
      <p data-details class="text-xs text-muted-foreground"></p>
      <time data-updated class="text-xs text-muted-foreground"></time>
    </div>
  </div>
  <a href="https://open-meteo.com/" class="block mt-2 text-[0.65rem] text-muted-foreground">Open-Meteo</a>
</section>
<script>
  import { weatherCondition, type WeatherSnapshot } from "@/src/lib/weather";
  import type { messages } from "@/src/lib/i18n";
  const section = document.getElementById("weather")!;
  const copy = JSON.parse(section.dataset.copy!) as typeof messages.en.weather;
  const condition = section.querySelector<HTMLElement>("[data-condition]")!;
  const details = section.querySelector<HTMLElement>("[data-details]")!;
  const updated = section.querySelector<HTMLTimeElement>("[data-updated]")!;
  const icon = section.querySelector<HTMLElement>("[data-icon]")!;
  async function refresh() {
    if (document.hidden) return;
    try {
      const response = await fetch("/api/weather", { signal: AbortSignal.timeout(10_000) });
      if (!response.ok) throw new Error("Unavailable");
      const data = await response.json() as WeatherSnapshot;
      const weather = weatherCondition(data.code);
      icon.textContent = !data.isDay && data.code <= 1 ? "🌙" : weather.icon;
      condition.textContent = `${Math.round(data.temperature)}°C · ${copy.conditions[weather.key]}`;
      details.textContent = `${copy.humidity}: ${Math.round(data.humidity)}% · ${copy.wind}: ${Math.round(data.wind)} km/h`;
      updated.dateTime = data.updatedAt;
      updated.textContent = new Date(data.updatedAt).toLocaleString(document.documentElement.lang, { hour: "2-digit", minute: "2-digit", timeZoneName: "short" });
    } catch {
      icon.textContent = "🌡️";
      condition.textContent = copy.unavailable;
      details.textContent = updated.textContent = "";
      updated.removeAttribute("datetime");
    }
  }
  refresh();
  document.addEventListener("visibilitychange", refresh);
  setInterval(refresh, 15 * 60_000);
</script>
