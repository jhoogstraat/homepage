---
import { Moon, Sun } from "@lucide/astro";
interface Props { label: string; }
const { label } = Astro.props;
---
<button id="theme-toggle" type="button" hidden class="p-2 rounded hover:bg-secondary" aria-label={label}>
  <Sun class="h-4 w-4 hidden dark:block" aria-hidden="true" />
  <Moon class="h-4 w-4 dark:hidden" aria-hidden="true" />
</button>
<script>
  const button = document.getElementById("theme-toggle")!;
  button.hidden = false;
  button.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });
</script>
