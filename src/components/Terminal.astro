---
import { messages, type Locale } from "@/src/lib/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { terminal, shortcuts } = messages[locale];
const items = [terminal.skills, terminal.hobbies, terminal.focus];
---
<section class="mb-8 text-sm border rounded-lg overflow-hidden" aria-label={terminal.title}>
  <div class="flex items-center gap-2 px-3 py-2 bg-secondary/50 border-b" aria-hidden="true">
    <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
    <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
    <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
    <span class="ml-2 text-xs text-muted-foreground">terminal — zsh</span>
  </div>
  <dl class="sr-only">{items.map((item) => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl>
  <div id="terminal-output" class="p-3 leading-6 bg-secondary/30" aria-hidden="true">
    {items.map((item) => <>
      <div class="terminal-line"><span class="text-primary mr-2">❯</span><span data-type>{item.command}</span></div>
      <div class="terminal-line text-muted-foreground"><span data-type>{item.text}</span></div>
    </>)}
    <div class="terminal-line text-xs text-muted-foreground"><span class="text-primary mr-2">❯</span><span data-type>{shortcuts.hint}</span><span class="terminal-cursor"></span></div>
  </div>
</section>
<style>
  .terminal-cursor { display: inline-block; width: 1px; height: 1em; margin-left: 2px; background: var(--foreground); vertical-align: -0.1em; }
  @media (prefers-reduced-motion: no-preference) {
    .terminal-cursor { animation: blink 1s steps(1) infinite; }
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
<script>
  const output = document.getElementById("terminal-output")!;
  const motion = matchMedia("(prefers-reduced-motion: reduce)");
  let played = motion.matches;
  try { played ||= sessionStorage.getItem("terminal-animated") === "true"; } catch {}
  if (!played) {
    const spans = [...output.querySelectorAll<HTMLElement>("[data-type]")];
    const texts = spans.map((span) => span.textContent!);
    const cursor = output.querySelector<HTMLElement>(".terminal-cursor")!;
    output.style.minHeight = `${output.getBoundingClientRect().height}px`;
    spans.forEach((span) => { span.textContent = ""; span.parentElement!.hidden = true; });
    async function animate() {
      try { sessionStorage.setItem("terminal-animated", "true"); } catch {}
      for (const [index, span] of spans.entries()) {
        span.parentElement!.hidden = false;
        span.parentElement!.append(cursor);
        for (const character of texts[index]) {
          if (motion.matches) break;
          span.textContent += character;
          await new Promise((resolve) => setTimeout(resolve, 22));
        }
        span.textContent = texts[index];
        if (!motion.matches) await new Promise((resolve) => setTimeout(resolve, 120));
      }
      output.style.removeProperty("min-height");
    }
    animate();
  }
</script>
