---
import { messages, type Locale } from "@/src/lib/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = messages[locale].music;
---
<section id="now-playing" class="border rounded-lg p-3 min-w-0" data-copy={JSON.stringify(copy)}>
  <div class="flex items-center gap-3">
    <div class="w-8 h-8 rounded bg-[#1DB954]/20 flex items-center justify-center shrink-0" aria-hidden="true">
      <svg class="w-4 h-4 text-[#1DB954]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z" />
      </svg>
    </div>
    <div class="min-w-0 flex-1">
      <h2 class="text-xs text-muted-foreground">Spotify · {copy.title}</h2>
      <p data-status class="text-xs text-muted-foreground">{copy.unavailable}</p>
      <div data-viewport class="overflow-hidden"><span data-track class="inline-block whitespace-nowrap text-sm font-medium"></span></div>
      <p data-artist class="text-xs text-muted-foreground break-words"></p>
    </div>
    <span data-playing hidden class="equalizer items-end gap-0.5 h-4 shrink-0" aria-hidden="true"><span></span><span></span><span></span></span>
  </div>
</section>
<style>
  .equalizer { display: inline-flex; }
  .equalizer span { width: 3px; height: 12px; background: #1db954; border-radius: 2px; }
  .equalizer span:nth-child(2) { height: 16px; animation-delay: 150ms; }
  .equalizer span:nth-child(3) { height: 8px; animation-delay: 300ms; }
  @media (prefers-reduced-motion: no-preference) {
    .equalizer span { animation: equalize 700ms ease-in-out infinite alternate; }
    .scrolling { animation: marquee var(--duration, 9s) ease-in-out infinite alternate; }
  }
  @keyframes equalize { to { transform: scaleY(0.4); } }
  @keyframes marquee { 0%, 15% { transform: translateX(0); } 85%, 100% { transform: translateX(calc(-1 * var(--distance))); } }
</style>
<script>
  import type { messages } from "@/src/lib/i18n";
  const section = document.getElementById("now-playing")!;
  const copy = JSON.parse(section.dataset.copy!) as typeof messages.en.music;
  const status = section.querySelector<HTMLElement>("[data-status]")!;
  const track = section.querySelector<HTMLElement>("[data-track]")!;
  const artist = section.querySelector<HTMLElement>("[data-artist]")!;
  const viewport = section.querySelector<HTMLElement>("[data-viewport]")!;
  const playing = section.querySelector<HTMLElement>("[data-playing]")!;
  function updateMarquee() {
    const distance = Math.max(0, track.scrollWidth - viewport.clientWidth);
    track.style.setProperty("--distance", `${distance}px`);
    track.style.setProperty("--duration", `${Math.min(18, Math.max(7, distance / 22))}s`);
    track.classList.toggle("scrolling", distance > 4);
  }
  const observer = new ResizeObserver(updateMarquee);
  observer.observe(viewport);
  observer.observe(track);
  async function refresh() {
    if (document.hidden) return;
    try {
      const response = await fetch("/api/spotify", { signal: AbortSignal.timeout(20_000) });
      if (!response.ok) throw new Error("Unavailable");
      const data = await response.json();
      status.textContent = data.source !== "spotify" ? copy.unavailable : data.isPlaying ? copy.playing : data.title ? copy.recent : copy.idle;
      track.textContent = data.title ?? "";
      artist.textContent = data.artist ?? "";
      playing.hidden = data.source !== "spotify" || data.isPlaying !== true;
      updateMarquee();
    } catch {
      status.textContent = copy.unavailable;
      track.textContent = artist.textContent = "";
      playing.hidden = true;
      updateMarquee();
    }
  }
  refresh();
  document.addEventListener("visibilitychange", refresh);
  setInterval(refresh, 30_000);
</script>
