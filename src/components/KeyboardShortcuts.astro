---
import { locales, localePath, messages, type Locale, type Page } from "@/src/lib/i18n";
interface Props { locale: Locale; page: Page; }
const { locale, page } = Astro.props;
const { nav, ui, shortcuts } = messages[locale];
const navigation = { h: "home", a: "about", l: "homelab" } as const;
---
<dialog id="keyboard-help" class="m-auto max-w-md w-[calc(100%-2rem)] max-h-[80vh] overflow-y-auto rounded-lg border p-6 bg-background text-foreground backdrop:bg-black/50" aria-labelledby="keyboard-help-title">
  <form method="dialog" class="flex items-center justify-between gap-4 mb-5">
    <h2 id="keyboard-help-title" class="font-semibold">{shortcuts.title}</h2>
    <button aria-label={shortcuts.close} class="rounded px-2 hover:bg-secondary" autofocus>×</button>
  </form>
  <label class="flex items-center gap-2 text-sm mb-5"><input id="shortcuts-enabled" type="checkbox" checked />{shortcuts.enabled}</label>
  <dl class="grid grid-cols-[4rem_1fr] gap-x-3 gap-y-2 text-sm">
    {Object.entries(navigation).map(([key, destination]) => <><dt><kbd>{key === "a" ? "a / b" : key}</kbd></dt><dd><a href={localePath(locale, destination)} data-key={key}>{nav[destination]}</a></dd></>)}
    <dt><kbd>t</kbd></dt><dd>{ui.theme}</dd>
    {locales.map((lang, index) => <><dt><kbd>{index + 1}</kbd></dt><dd><a href={localePath(lang, page)} data-key={String(index + 1)} lang={lang}>{{ de: "Deutsch", en: "English", es: "Español" }[lang]}</a></dd></>)}
    <dt><kbd>j / k</kbd></dt><dd>{shortcuts.down} / {shortcuts.up}</dd>
    <dt><kbd>g / gg</kbd></dt><dd>{shortcuts.top}</dd>
    <dt><kbd>G</kbd></dt><dd>{shortcuts.bottom}</dd>
    <dt><kbd>?</kbd></dt><dd>{shortcuts.title}</dd>
    <dt><kbd>Esc</kbd></dt><dd>{shortcuts.close}</dd>
  </dl>
</dialog>
<script>
  const dialog = document.getElementById("keyboard-help") as HTMLDialogElement;
  const trigger = document.getElementById("keyboard-help-toggle")!;
  const enabled = document.getElementById("shortcuts-enabled") as HTMLInputElement;
  try { enabled.checked = localStorage.getItem("keyboard-shortcuts") !== "off"; } catch {}
  enabled.addEventListener("change", () => {
    try { localStorage.setItem("keyboard-shortcuts", enabled.checked ? "on" : "off"); } catch {}
  });
  trigger.hidden = false;
  trigger.addEventListener("click", () => dialog.open ? dialog.close() : dialog.showModal());
  dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  document.addEventListener("keydown", (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || target.closest("input, textarea, select"))) return;
    if (event.key === "?") { event.preventDefault(); trigger.click(); return; }
    if (dialog.open || !enabled.checked) return;
    const key = event.key === "b" ? "a" : event.key;
    const link = [...dialog.querySelectorAll<HTMLAnchorElement>("[data-key]")].find((item) => item.dataset.key === key);
    if (link) { event.preventDefault(); link.click(); return; }
    if (key === "t") { event.preventDefault(); document.getElementById("theme-toggle")?.click(); }
    const behavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth";
    if (key === "j" || key === "k") { event.preventDefault(); window.scrollBy({ top: key === "j" ? 100 : -100, behavior }); }
    if (key === "g" || key === "G") { event.preventDefault(); window.scrollTo({ top: key === "g" ? 0 : document.documentElement.scrollHeight, behavior }); }
  });
</script>
