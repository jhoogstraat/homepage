---
import { messages, type Locale } from "@/src/lib/i18n";
interface Props { locale: Locale; page: "imprint" | "privacy"; }
const { locale, page } = Astro.props;
const copy = messages[locale].legal[page];
type Section = { title: string; text?: string; items?: string[] | Record<string, { label: string; value: string }> };
const sections: Section[] = Object.values(copy.sections);
---
<h1 class="text-4xl font-bold mb-4">{copy.title}</h1>
<p class="text-muted-foreground mb-8">{copy.description}</p>
<div class="space-y-8">
  {sections.map((section) => (
    <section class="space-y-3">
      <h2 class="text-lg font-semibold">{section.title}</h2>
      {section.text && <p class="text-sm text-muted-foreground">{section.text}</p>}
      {Array.isArray(section.items) ? <ul class="list-disc pl-5 text-sm text-muted-foreground space-y-2">{section.items.map((item) => <li>{item}</li>)}</ul>
        : section.items && <dl class="text-sm space-y-2">{Object.values(section.items).map((item) => <div><dt class="text-muted-foreground">{item.label}</dt><dd>{item.value.includes("@") ? <a href={`mailto:${item.value}`}>{item.value}</a> : item.value}</dd></div>)}</dl>}
    </section>
  ))}
</div>
