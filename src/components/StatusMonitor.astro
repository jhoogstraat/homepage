---
import { localePath, messages, type Locale } from "@/src/lib/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { status, homelab } = messages[locale];
---
<section id="status-monitor" class="border rounded-lg p-4" data-copy={JSON.stringify({ ...homelab, ...status })}>
  <div class="flex items-center justify-between gap-3 mb-3">
    <h2 class="text-sm font-semibold">{status.title}</h2>
    <a href={localePath(locale, "homelab")} class="text-xs text-muted-foreground hover:text-primary">{status.details} →</a>
  </div>
  <p data-message class="text-xs text-muted-foreground">{homelab.unavailable}</p>
  <ul data-services class="divide-y divide-border mt-2"></ul>
  <p data-updated class="text-xs text-muted-foreground mt-3"></p>
</section>
<script>
  import type { Snapshot, Status } from "@/src/lib/homelab";
  import type { messages } from "@/src/lib/i18n";
  const section = document.getElementById("status-monitor")!;
  const copy = JSON.parse(section.dataset.copy!) as typeof messages.en.homelab & typeof messages.en.status;
  const message = section.querySelector<HTMLElement>("[data-message]")!;
  const services = section.querySelector<HTMLElement>("[data-services]")!;
  const updated = section.querySelector<HTMLElement>("[data-updated]")!;
  const colors: Record<Status, string> = { running: "bg-green-500", degraded: "bg-yellow-500", exited: "bg-red-500", pending: "bg-slate-400" };
  async function refresh() {
    if (document.hidden) return;
    try {
      const response = await fetch("/api/homelab", { signal: AbortSignal.timeout(20_000) });
      if (!response.ok) throw new Error("Unavailable");
      const data = await response.json() as Snapshot;
      message.textContent = `${data.system} · ${copy[data.systemStatus]}`;
      services.replaceChildren(...data.rows.map((row) => {
        const item = document.createElement("li");
        item.className = "flex items-center gap-2 py-2 text-sm";
        const dot = document.createElement("span");
        dot.className = `w-2 h-2 rounded-full shrink-0 ${colors[row.status]}`;
        dot.setAttribute("aria-hidden", "true");
        const name = document.createElement("span");
        name.className = "min-w-0 flex-1 break-words";
        name.textContent = row.name;
        const label = document.createElement("span");
        label.className = "text-xs text-muted-foreground";
        label.textContent = copy[row.status];
        item.append(dot, name, label);
        return item;
      }));
      if (!data.rows.length) message.textContent += ` · ${copy.empty}`;
      updated.textContent = data.syncedAt ? `${copy.updated}: ${new Date(data.syncedAt).toLocaleString(document.documentElement.lang)}` : "";
    } catch {
      message.textContent = copy.unavailable;
      services.replaceChildren();
      updated.textContent = "";
    }
  }
  refresh();
  document.addEventListener("visibilitychange", refresh);
  setInterval(refresh, 30_000);
</script>
