---
import ThemeToggle from "./ThemeToggle.astro";
import { locales, localePath, messages, type Locale, type Page } from "@/src/lib/i18n";
interface Props { locale: Locale; page: Page; }
const { locale, page } = Astro.props;
const copy = messages[locale];
const languageNames = { de: "Deutsch", en: "English", es: "Español" };
const navigation = ["home", "about", "homelab"] as const;
---
<header class="sticky top-0 z-40 bg-background/95 border-b py-4 flex flex-wrap items-center justify-between gap-3">
  <nav aria-label={copy.ui.navigation} class="flex flex-wrap gap-x-5 gap-y-2 text-sm uppercase">
    {navigation.map((item) => (
      <a href={localePath(locale, item)} aria-current={page === item ? "page" : undefined} class:list={["hover:text-primary", page === item ? "font-semibold text-primary" : "text-muted-foreground"]}>{copy.nav[item]}</a>
    ))}
  </nav>
  <div class="flex items-center gap-3">
    <button id="keyboard-help-toggle" type="button" hidden class="min-w-8 min-h-8 rounded hover:bg-secondary text-sm" aria-label={copy.shortcuts.title} aria-haspopup="dialog">?</button>
    <ThemeToggle label={copy.ui.theme} />
    <nav aria-label={copy.ui.languages} class="flex gap-2 text-xs uppercase">
      {locales.map((lang) => <a href={localePath(lang, page)} lang={lang} hreflang={lang} aria-label={languageNames[lang]} aria-current={lang === locale ? "true" : undefined} class:list={["inline-flex min-w-6 min-h-6 items-center justify-center hover:text-primary", lang === locale ? "font-semibold" : "text-muted-foreground"]}>{lang}</a>)}
    </nav>
  </div>
</header>
