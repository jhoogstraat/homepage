---
import { localePath, messages, type Locale } from "@/src/lib/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { contact, legal } = messages[locale];
const links = ["email", "github", "mastodon", "bluesky", "linkedin"] as const;
---
<footer class="border-t py-8 mb-8 text-sm">
  <div class="flex flex-wrap gap-x-5 gap-y-2">
    {links.map((name) => <a class="text-muted-foreground hover:text-primary" href={contact[`${name}_url`]} rel={name === "mastodon" ? "me" : undefined}>{contact[`${name}_label`]}</a>)}
  </div>
  <div class="mt-4 flex gap-5 text-xs text-muted-foreground uppercase">
    <a href={localePath(locale, "imprint")}>{legal.links.imprint}</a>
    <a href={localePath(locale, "privacy")}>{legal.links.privacy}</a>
  </div>
</footer>
